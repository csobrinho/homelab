# Copy to tofu/proxmox.sops.yaml, fill in real values, then encrypt in place:
#
#   cp tofu/proxmox.sops.yaml.example tofu/proxmox.sops.yaml
#   $EDITOR tofu/proxmox.sops.yaml
#   sops --encrypt --in-place tofu/proxmox.sops.yaml
#
# The .sops.yaml creation_rule for '.*\.sops\.(yaml|json|env)$' encrypts the
# whole file to the primary + recovery age keys. `just tofu ...` runs every
# command under `sops exec-env`, so each top-level key below becomes an env var.

# Proxmox API endpoint (trailing slash, port 8006).
PROXMOX_VE_ENDPOINT: https://infra-vm.example.net:8006/

# API token: create under Datacenter > Permissions > API Tokens.
# Needs on / (propagate): VM.Allocate, VM.Config.*, VM.PowerMgmt, VM.Audit,
# Datastore.AllocateSpace, Datastore.Audit, Datastore.AllocateTemplate,
# Sys.Audit, Sys.Modify. Format: <user>@<realm>!<token-id>=<uuid>
PROXMOX_VE_API_TOKEN: tofu@pve!controlplane=00000000-0000-0000-0000-000000000000

# Set to "true" if the PVE endpoint uses a self-signed certificate.
PROXMOX_VE_INSECURE: "false"

# Passphrase for OpenTofu state/plan encryption (min 16 chars; generate with
# `openssl rand -base64 32`). Losing this makes tofu/terraform.tfstate unreadable.
TOFU_STATE_PASSPHRASE: change-me-to-a-long-random-string
