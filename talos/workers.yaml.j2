---
machine:
  type: worker
  # ca merges as a unit; workers carry crt only (no key). cluster.yaml.j2 already
  # supplies machine.ca.crt, but repeating it here keeps the role patch honest.
  ca:
    crt: {{ sops.certs.os.crt }}
---
# Stable /dev names for passed-through USB sticks (same 1a86:55d4 id, so match on product string).
# GROUP 568 lets non-root pods (568:568) open them.
apiVersion: v1alpha1
kind: UdevRulesConfig
rules:
  - SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d4", ATTRS{product}=="*Z-Wave*", SYMLINK+="zwave", GROUP="568", MODE="0660"
  - SUBSYSTEM=="tty", ATTRS{idVendor}=="1a86", ATTRS{idProduct}=="55d4", ATTRS{product}=="*Zigbee*", SYMLINK+="zigbee", GROUP="568", MODE="0660"
