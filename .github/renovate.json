{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "assignees": ["csobrinho"],
  "minimumReleaseAge": "48 hours",
  "prConcurrentLimit": 0,
  "fetchChangeLogs": "pr",
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["patch"],
      "schedule": ["before 6am"],
      "automerge": true
    },
    {
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["minor"],
      "schedule": ["before 6am"],
      "automerge": true
    },
    {
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["major"],
      "schedule": ["before 6am"],
      "automerge": false
    },
    {
      "matchPackageNames": ["cilium/cilium", "quay.io/cilium/cilium"],
      "enabled": false
    },
    {
      "matchDatasources": ["helm"],
      "matchPackageNames": ["rook-ceph", "rook-ceph-cluster"],
      "enabled": false
    },
    {
      "description": "Talos/Kubernetes in talos/versions.yaml: don't let the installer 'latest' tag block RC->stable bumps",
      "matchFileNames": ["talos/versions.yaml"],
      "respectLatest": false
    }
  ],
  "helm-values": {
    "managerFilePatterns": ["/\\.ya?ml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.ya?ml$/"],
      "matchStrings": ["# renovate: depName=(?<depName>\\S+)\\s+app\\.kubernetes\\.io/version: (?<currentValue>.*?)\\s"],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "kustomize version in validate_kustomize.yaml",
      "managerFilePatterns": [
        "/\\.github/workflows/validate_kustomize\\.yaml/"
      ],
      "matchStrings": ["kustomize-version:\\s+\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "kubernetes-sigs/kustomize",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^kustomize/v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Talos and Kubernetes versions in talos/versions.yaml",
      "managerFilePatterns": ["/talos/versions\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+[a-zA-Z_]+:\\s+\"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}docker{{/if}}"
    }
  ],
  "automerge": true,
  "ignoreTests": false,
  "major": {
    "automerge": false
  }
}
