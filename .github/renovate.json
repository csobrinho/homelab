{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "assignees": ["csobrinho"],
  "minimumReleaseAge": "48 hours",
  "prConcurrentLimit": 0,
  "fetchChangeLogs": "pr",
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["patch"],
      "schedule": ["before 6am"],
      "automerge": true
    },
    {
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["minor"],
      "schedule": ["before 6am"],
      "automerge": true
    },
    {
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["major"],
      "schedule": ["before 6am"],
      "automerge": false
    },
    {
      "description": "Strata tags hotfixes as a 4th part (0.2.1.1-cuda13); docker versioning won't cross 4 -> 3 parts",
      "matchPackageNames": ["ghcr.io/niko1221/strata"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(?:\\.(?<build>\\d+))?-(?<compatibility>cuda13)$"
    },
    {
      "matchPackageNames": ["cilium/cilium", "quay.io/cilium/cilium"],
      "enabled": false
    },
    {
      "matchDatasources": ["helm"],
      "matchPackageNames": ["rook-ceph", "rook-ceph-cluster"],
      "enabled": false
    },
    {
      "description": "Kubernetes in talos/versions.yaml and tuppr: don't let the kubelet 'latest' tag block RC->stable bumps",
      "matchFileNames": ["talos/versions.yaml", "kubernetes/apps/tuppr/**"],
      "respectLatest": false
    },
    {
      "description": "Talos group: mise talosctl joins talos/versions.yaml + tuppr TalosUpgrade (merging rolls the cluster)",
      "matchManagers": ["mise"],
      "matchDepNames": ["talos"],
      "groupName": "talos",
      "automerge": false
    },
    {
      "description": "Talos group: siderolabs/talos refs in talos/versions.yaml and the tuppr TalosUpgrade (factory has no release timestamps, so don't let minimumReleaseAge drop them)",
      "matchPackageNames": ["siderolabs/talos"],
      "groupName": "talos",
      "minimumReleaseAgeBehaviour": "timestamp-optional",
      "automerge": false
    },
    {
      "description": "Talos group: wolf-nvidia-driver is tagged by Talos release (its driver-version tags would look like a major bump), so it ships in the Talos PR, as soon as it's built",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/csobrinho/wolf-nvidia-driver"],
      "allowedVersions": "/^v\\d+\\.\\d+\\.\\d+$/",
      "groupName": "talos",
      "schedule": ["at any time"],
      "minimumReleaseAge": "0 days",
      "automerge": false
    }
  ],
  "customDatasources": {
    "talos-factory": {
      "description": "Only offers Talos versions the image factory can build (from home-operations/renovate-presets)",
      "defaultRegistryUrlTemplate": "https://factory.talos.dev/versions",
      "format": "json",
      "transformTemplates": ["{\"releases\": [$.{\"version\": $}]}"]
    }
  },
  "helm-values": {
    "managerFilePatterns": ["/\\.ya?ml$/"]
  },
  "kustomize": {
    "description": "TEMP: skip supermarket's prod overlay; its local helmChart (no repo) crashes Renovate 44.171.2-44.175.1 in hasUrlCredentials (fixed in 44.175.2, renovatebot/renovate#47256). Drop once Mend runs >= 44.175.2.",
    "managerFilePatterns": [
      "kubernetes/!(apps)/**/kustomization.y?(a)ml",
      "kubernetes/apps/!(supermarket)/**/kustomization.y?(a)ml",
      "kubernetes/apps/supermarket/base/kustomization.y?(a)ml"
    ]
  },
  "kubernetes": {
    "managerFilePatterns": ["/\\.ya?ml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: depName=(?<depName>\\S+)\\s+app\\.kubernetes\\.io/version: (?<currentValue>.*?)\\s"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "kustomize version in validate_kustomize.yaml",
      "managerFilePatterns": ["/\\.github/workflows/validate_kustomize\\.yaml/"],
      "matchStrings": ["kustomize-version:\\s+\"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "kubernetes-sigs/kustomize",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^kustomize/v(?<version>.+)$"
    },
    {
      "customType": "regex",
      "description": "Talos and Kubernetes versions in talos/versions.yaml and the tuppr upgrade CRs",
      "managerFilePatterns": ["/talos/versions\\.ya?ml$/", "/kubernetes/apps/tuppr/.+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+[a-zA-Z_]+:\\s+\"?(?<currentValue>[^\"\\s]+)\"?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}docker{{/if}}"
    },
    {
      "customType": "regex",
      "description": "Images Wolf launches, in kubernetes/apps/games/overlays/prod/wolf/*.toml",
      "managerFilePatterns": ["/kubernetes/apps/games/overlays/prod/wolf/.+\\.toml$/"],
      "matchStrings": [
        "image = '(?<depName>[^:']+):(?<currentValue>[^@']+)@(?<currentDigest>sha256:[a-f0-9]+)'"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "automerge": true,
  "ignoreTests": false,
  "major": {
    "automerge": false
  }
}
